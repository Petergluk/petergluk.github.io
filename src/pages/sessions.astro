---
import Layout from '../layouts/Layout.astro';

const formats = [
	{
		tag: 'Онлайн',
		title: 'Соматический Метакоучинг',
		body: [
			'Авторский метод работы с подсознанием через телесную метафору. Любая проблема, которую вы можете описать, откликается ощущениями в теле. Метод позволяет распаковать глубинный смысл ощущения и перезаписать программу реагирования.',
			'Запрос, как правило, разрешается за одну сессию, однако возможна и длительная работа.',
		],
	},
	{
		tag: 'Очно',
		title: 'Интегральная телесная сессия',
		body: [
			'Очная сессия, соединяющая трансовый медитативный массаж, работу с дыханием и соматический коучинг. Тело получает глубокую перезагрузку, а сознание — доступ к тем слоям, куда словами не добраться.',
			'Возможен и «чистый» массаж — внимательный, ритмичный, погружающий в глубокий кинестетический транс.',
		],
	},
	{
		tag: 'Очно · 3–7 дней',
		title: 'Индивидуальный ретрит',
		body: [
			'От трёх до семи дней мы практикуем вместе. Ретрит выстраивается под ваш запрос: телесная работа, дыхание, медитация, коучинг — в том сочетании и темпе, который нужен именно вам.',
		],
	},
];

const requests = [
	{
		title: 'Невозможность',
		text: 'Вроде хочу, могу и всё понимаю — но каждый раз почему-то не получается. Где-то происходит сбой, но обнаружить где — не удаётся.',
	},
	{
		title: 'Повторяющийся сценарий',
		text: '«Почему со мной всегда так?» Понимаю, как надо, но делаю наоборот.',
	},
	{
		title: 'Состояние',
		text: 'Освободить дыхание, замедлиться, расслабиться, соединиться с собой, разрешить себе почувствовать. Или наоборот — выйти из сложного состояния.',
	},
	{
		title: 'Телесный или психосоматический симптом',
		text: 'Что-то болит или ощущается «неправильно».',
	},
	{
		title: 'Поиск решения',
		text: 'Распутать запутанные смыслы, определить ценности, услышать себя, увидеть путь.',
	},
	{
		title: 'Без запроса',
		text: '«Чувствую, что надо, но не могу сказать зачем» — тоже нормальный запрос. Будем прислушиваться к ощущениям тела и работать с тем, что поднимается.',
	},
];

const faq = [
	{
		q: 'Как возможна телесная сессия онлайн?',
		a: 'Любая проблема обязательно как-то откликается в ощущениях тела. Выяснилось, что физический контакт не является необходимостью — достаточно контакта внимания. Телесный компонент в онлайн-сессиях присутствует, потому что именно через тело мы входим в глубокие слои психического содержания.',
	},
	{
		q: 'Как проходит онлайн-сессия? В формате разговора?',
		a: 'В целом да, но это не совсем обычный разговор. Я задаю вопросы не вам, а чему-то в вас: прошу посмотреть на ощущения в теле, предлагаю прояснить отношения между разными «я» — и через разворачивание скрытых смыслов происходит трансформация, которая приводит к изменениям в жизни.',
	},
];
---

<Layout
	title="Индивидуальные сессии — Пётр Глухов"
	description="Соматический метакоучинг онлайн, телесные сессии с массажем и дыханием очно, индивидуальные ретриты. Запись через Telegram и WhatsApp."
>
	<main id="content">
		<section class="page-hero">
			<div class="wrap">
				<span class="eyebrow">Индивидуальная работа</span>
				<h1>Индивидуальные сессии</h1>
				<p class="lede">
					Результат нашей работы — состояние, из которого доступны новые ресурсы и
					возможности.
				</p>
			</div>
		</section>

		<section class="band">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">Форматы</span>
					<h2>Как мы можем работать</h2>
				</div>
				<div class="grid grid-3">
					{
						formats.map((item) => (
							<div class="card">
								<span class="tag">{item.tag}</span>
								<h3>{item.title}</h3>
								{item.body.map((p) => (
									<p class="muted">{p}</p>
								))}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="band band-warm">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">Запросы</span>
					<h2>С чем приходят</h2>
				</div>
				<ul class="checklist">
					{
						requests.map((item) => (
							<li>
								<strong>{item.title}.</strong> {item.text}
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="band">
			<div class="wrap-narrow">
				<span class="eyebrow">Подход</span>
				<h2>Как я работаю</h2>
				<p class="muted">
					Я сознательно ухожу из контекста «терапии» и медицинских коннотаций,
					предполагающих, что с клиентом что-то не так. С моей точки зрения — с вами всё
					так. Если у вас возник запрос, значит у вас уже есть решение; я просто помогаю
					его увидеть и ратифицировать.
				</p>
				<p class="muted">
					Индивидуальная сессия — это сотрудничество. Я ничего не «делаю с вами», не
					ставлю диагноз, не лечу. Я помогаю провести в жизнь то изменение, которым вы
					хотите стать.
				</p>

				<h2 style="margin-top: 2.8rem;">Вопросы</h2>
				{
					faq.map((item) => (
						<div class="faq-item">
							<h3>{item.q}</h3>
							<p>{item.a}</p>
						</div>
					))
				}
			</div>
		</section>

		<section class="band band-dark">
			<div class="wrap-narrow" style="text-align: center;">
				<span class="eyebrow">Запись</span>
				<h2>Записаться на сессию</h2>
				<p class="muted">
					Напишите мне — обсудим запрос и подберём формат.
					<a href="https://photos.app.goo.gl/kVSBV58ioTUoUSCNA">Отзывы о моей работе</a>.
				</p>
				<div class="cta-row" style="justify-content: center;">
					<a class="btn" href="https://t.me/Petergluk">Telegram</a>
					<a class="btn secondary" href="https://wa.me/qr/RX52QNWK3LNOB1">WhatsApp</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
