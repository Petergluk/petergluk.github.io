---
import Layout from '../../layouts/Layout.astro';

type Post = {
	url: string;
	frontmatter: {
		title?: string;
		description?: string;
		date?: string;
		tags?: string[];
		image?: string;
	};
};

const posts = Object.values(import.meta.glob('./*.md', { eager: true })) as Post[];

posts.sort((a, b) => (b.frontmatter.date ?? '').localeCompare(a.frontmatter.date ?? ''));

// Собираем теги и считаем, сколько текстов в каждом
const counts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.frontmatter.tags ?? []) {
		counts.set(tag, (counts.get(tag) ?? 0) + 1);
	}
}

const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const formatDate = (date?: string) =>
	date
		? new Date(date).toLocaleDateString('ru-RU', {
				day: 'numeric',
				month: 'long',
				year: 'numeric',
			})
		: null;
---

<Layout
	title="Тексты — Пётр Глухов"
	description="Статьи и заметки о телесной работе, психосоматике, массаже и практиках внимания."
>
	<main id="content">
		<section class="page-hero">
			<div class="wrap">
				<span class="eyebrow">Читать</span>
				<h1>Тексты</h1>
				<p class="lede">
					Заметки о телесной работе, психосоматике, массаже и практиках внимания.
				</p>
			</div>
		</section>

		{
			tags.length > 0 && (
				<section class="tagbar">
					<div class="wrap">
						<div class="tag-filter" role="group" aria-label="Фильтр по темам">
							<button class="chip is-active" data-tag="*" aria-pressed="true">
								Все
								<span class="chip-count">{posts.length}</span>
							</button>
							{tags.map(([tag, count]) => (
								<button class="chip" data-tag={tag} aria-pressed="false">
									{tag}
									<span class="chip-count">{count}</span>
								</button>
							))}
						</div>
					</div>
				</section>
			)
		}

		<section class="band">
			<div class="wrap">
				{
					posts.length === 0 ? (
						<p class="muted">
							Здесь скоро появятся статьи. Пока что — заходите в
							<a href="https://t.me/danceofsense"> Телеграм-канал</a>.
						</p>
					) : (
						<>
							<div class="grid grid-auto" id="post-grid">
								{posts.map((post, i) => (
									<a
										class="card post-card"
										href={post.url}
										data-tags={(post.frontmatter.tags ?? []).join('|')}
									>
										{post.frontmatter.image ? (
											<div class="card-cover" style={`background-image: url('${post.frontmatter.image}'); background-size: cover; background-position: center;`} />
										) : (
											<div class="card-cover" style={`background-image: url('/images/defolt/bg_${String((i % 15) + 1).padStart(2, "0")}.jpg'); background-size: cover; background-position: center;`} />
										)}
										
										<h3 style="font-size: 1.6rem; margin-top: 1rem; margin-bottom: 0.5rem; line-height: 1.2;">{post.frontmatter.title ?? 'Без названия'}</h3>
										{post.frontmatter.description && (
											<p class="muted">{post.frontmatter.description}</p>
										)}
										
										
									</a>
								))}
							</div>
							<p class="empty-note" id="empty-note" hidden>
								По этой теме пока нет текстов.
							</p>
						</>
					)
				}
			</div>
		</section>
	</main>
</Layout>

<script>
	const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
	const cards = document.querySelectorAll<HTMLElement>('.post-card');
	const emptyNote = document.getElementById('empty-note');

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			const tag = chip.dataset.tag ?? '*';

			chips.forEach((c) => {
				const active = c === chip;
				c.classList.toggle('is-active', active);
				c.setAttribute('aria-pressed', String(active));
			});

			let shown = 0;
			cards.forEach((card) => {
				const cardTags = (card.dataset.tags ?? '').split('|').filter(Boolean);
				const match = tag === '*' || cardTags.includes(tag);
				card.hidden = !match;
				if (match) shown++;
			});

			if (emptyNote) emptyNote.hidden = shown > 0;
		});
	});
</script>

<style>
	.tagbar {
		background: var(--paper-warm);
		border-bottom: 1px solid var(--line);
		padding: 1.1rem 0;
	}

	.tag-filter {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.9rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--card);
		color: var(--ink-soft);
		font-family: var(--body);
		font-size: 0.88rem;
		cursor: pointer;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.chip:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.chip.is-active {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.chip-count {
		font-size: 0.76rem;
		opacity: 0.65;
		font-variant-numeric: tabular-nums;
	}

	.post-date {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
		margin: 0 0 0.5rem;
	}

	.post-tags {
		margin: 0.9rem 0 0.4rem;
	}

	.post-card[hidden] {
		display: none;
	}

	.empty-note {
		color: var(--ink-soft);
		margin: 0;
	}
</style>
