---
import Layout from '../../layouts/Layout.astro';
import categoriesData from '../../data/categories.json';
const categories = categoriesData.categories;

export function getStaticPaths() { const categories = categoriesData.categories;
	return categories.map((category) => ({
		params: { category: category.id },
		props: { category },
	}));
}

const { category } = Astro.props;
---

<Layout
	title={`${category.title} — Мастер-классы Пётр Глухов`}
	description={category.description}
>
	<main id="content">
		<section class="page-hero">
			<div class="wrap">
				<span class="eyebrow">Мастер-классы</span>
				<h1>{category.title}</h1>
				<p class="lede">
					{category.subtitle}
				</p>
			</div>
		</section>
		<section class="band">
			<div class="wrap">
				<div class="prose intro">
					<p>{category.description}</p>
				</div>

				{category.id === 'dyhanie' && (() => {
					const lab = category.classes.find(c => c.id === 'laboratoriya');
					if (!lab) return null;
					return (
						<div class="lab-section">
							<div class="section-head">
								<span class="eyebrow">Большой курс</span>
								<h2>Онлайн-ретрит на 5 недель</h2>
								<p class="muted" style="margin-top: 1rem; max-width: 800px; font-size: 1.05rem;">
									Важно: ниже представлены отдельные, разовые мастер-классы (каждый содержит по одной практике на 1,5-2 часа). А "Лаборатория дыхания" — это большой онлайн-ретрит, который длится 5 недель и включает в себя более 40 практик, в том числе всё то, что даётся на коротких мастер-классах, но системно и глубоко.
								</p>
							</div>
							
							<a class="card class-item-horiz lab-card" href="/laboratoriya-dyhaniya/">
								<div class="card-cover-horiz" style="background-image: url('/images/defolt/bg_01.jpg'); background-size: cover; background-position: center;" />
								<div class="class-content">
									<h3 style="font-size: 1.8rem; margin-bottom: 1rem; color: var(--accent);">{lab.title}</h3>
									<div class="muted class-desc" set:html={lab.description} />
									<span class="link-label">Узнать подробности &rarr;</span>
								</div>
							</a>
						</div>
					);
				})()}

				<div class="classes-list">
					<h2 style={category.id === 'dyhanie' ? 'margin-top: 4rem;' : ''}>
						{category.id === 'dyhanie' ? 'Разовые мастер-классы' : 'Мастер-классы в этом направлении'}
					</h2>
					<div class="classes-grid">
						{
							category.classes.filter(c => c.id !== 'laboratoriya').map((cls, i) => (
								<a class="card class-item-horiz" href={cls.link || `/classes/${category.id}/${cls.id}/`}>
									{cls.image ? (
										<div class="card-cover-horiz" style={`background-image: url('${cls.image}'); background-size: cover; background-position: center;`} />
									) : (
										<div class="card-cover-horiz" style={`background-image: url('/images/defolt/bg_${String((i % 15) + 1).padStart(2, "0")}.jpg'); background-size: cover; background-position: center;`} />
									)}
									<div class="class-content">
										<h3 style="font-size: 1.6rem; margin-bottom: 0.8rem; line-height: 1.2;">{cls.title}</h3>
										<div class="muted class-desc" set:html={cls.description} />
										
									</div>
								</a>
							))
						}
					</div>
				</div>

				<p class="back"><a href="/classes/">← Все направления</a></p>
			</div>
		</section>
	</main>
</Layout>

<style>
	.intro {
		margin-bottom: 4rem;
	}
	.intro p {
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--prose-ink);
	}
	.classes-list h2 {
		font-family: var(--display);
		font-weight: 500;
		font-size: 2.2rem;
		margin-bottom: 2rem;
		color: var(--ink);
	}
	.classes-grid {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.class-item-horiz {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		padding: 0;
		overflow: hidden;
	}
	@media (min-width: 768px) {
		.class-item-horiz {
			flex-direction: row;
		}
	}
	.card-cover-horiz {
		height: 200px;
		flex-shrink: 0;
	}
	@media (min-width: 768px) {
		.card-cover-horiz {
			width: 300px;
			height: auto;
		}
	}
	.class-content {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}
	.class-content h3 {
		font-size: 1.35rem;
		margin-top: 0;
		margin-bottom: 0.8rem;
	}
	.link-label {
		margin-top: auto;
		padding-top: 1rem;
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 500;
	}
	.class-desc {
		font-size: 0.95rem;
		line-height: 1.5;
		margin-bottom: 0.5rem;
	}
	.class-desc :global(strong) {
		color: var(--ink);
		font-weight: 600;
	}
	.class-desc :global(br) {
		display: block;
		content: "";
		margin-top: 0.5rem;
	}
	.back {
		margin: 4rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}
	.back a {
		text-decoration: none;
		font-size: 0.95rem;
	}

	.lab-section {
		margin-bottom: 4rem;
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--line);
	}
	.lab-card {
		border: 2px solid var(--accent-soft);
		background: var(--paper-warm);
	}
	.lab-card:hover {
		border-color: var(--accent);
	}
</style>
