---
import Layout from '../layouts/Layout.astro';
import contactsData from '../data/pages/contacts.json';
---

<Layout
	title={contactsData.title}
	description={contactsData.description}
>
	<main id="content">
		<section class="page-hero">
			<div class="wrap">
				<span class="eyebrow">{contactsData.hero.eyebrow}</span>
				<h1>{contactsData.hero.title}</h1>
				<p class="lede">
					{contactsData.hero.lede}
				</p>
			</div>
		</section>

		<section class="band">
			<div class="wrap">
				<div class="grid grid-3">
					{contactsData.links.map(link => (
						<a href={link.url} class="card" target="_blank" rel="noopener noreferrer">
							<span class="tag">{link.tag}</span>
							<h3>{link.title}</h3>
							<p class="muted">{link.muted}</p>
							<span class="arrow">→</span>
						</a>
					))}
				</div>

				<div class="cta-row" style="margin-top: 3rem;">
					<a class="btn secondary" href={contactsData.cta.url} target="_blank" rel="noopener noreferrer">
						{contactsData.cta.text}
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
