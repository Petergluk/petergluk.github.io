---
import Layout from '../layouts/Layout.astro';
import homeData from '../data/pages/home.json';

const portraitSize = Number(homeData.portrait_size) || 285;
const rawFontSize = homeData.font_size != null ? Number(homeData.font_size) : 2.35;
const fontSizeRem = rawFontSize > 10 ? rawFontSize / 16 : rawFontSize;
const rawLineHeight = homeData.line_height != null ? Number(homeData.line_height) : 1.3;
const lineHeight = rawLineHeight > 0 ? rawLineHeight : 1.3;
const formattedIntroText = (homeData.intro_text || '').replace(/\n/g, '<br/>');
---

<Layout
	title={homeData.title}
	description={homeData.description}
	entry={true}
>
	<main
		id="content"
		class="entry"
		style={`--portrait-size: ${portraitSize}px; --portrait-grid: ${portraitSize}px; --entry-font-size: ${fontSizeRem}rem; --entry-line-height: ${lineHeight};`}
	>
		<div class="entry-inner" id="entryInner">
			<div class="entry-portrait" id="entryPortrait">
				<img id="portraitImg" src={`${homeData.portrait}?v=${Date.now()}`} alt="Пётр Глухов" />
			</div>
			<div class="entry-content">
				<p class="entry-text" id="entryText" set:html={formattedIntroText}></p>
			</div>
		</div>
	</main>
</Layout>

<style>
	.entry {
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 3rem 1.75rem;
		background-color: var(--entry-bg);
		background-image: var(--entry-bg-image, radial-gradient(circle at 100% 0%, var(--entry-glow, transparent) 0%, transparent 60%));
	}

	.entry-inner {
		max-width: 60rem;
		animation: rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 580px) {
		.entry-inner {
			grid-template-columns: min(var(--portrait-size, 285px), 40%) 1fr;
			gap: 2.5rem;
		}
	}

	@media (min-width: 768px) {
		.entry-inner {
			grid-template-columns: var(--portrait-size, 285px) 1fr;
			gap: 3.5rem;
		}
	}

	.entry-portrait {
		width: 100%;
		max-width: var(--portrait-size, 285px);
		margin: 0 auto;
	}

	@media (max-width: 579px) {
		.entry-portrait {
			max-width: min(var(--portrait-size, 285px), 230px);
		}
	}

	.entry-portrait img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: 0 20px 40px -10px rgba(0,0,0,0.15);
	}

	.entry-text {
		font-family: var(--display);
		font-weight: 400;
		font-size: clamp(1.5rem, 3vw + 0.7rem, var(--entry-font-size, 2.35rem));
		line-height: var(--entry-line-height, 1.3);
		color: var(--entry-ink-dim);
		margin: 0;
	}

	@media (min-width: 768px) {
		.entry-text {
			font-size: var(--entry-font-size, 2.35rem);
		}
	}

	.entry-text :global(a) {
		color: var(--entry-ink);
		text-decoration: none;
		font-weight: 600;
		background-image: linear-gradient(var(--entry-accent), var(--entry-accent));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 2px;
		transition: background-size 0.3s ease, color 0.2s ease;
	}

	.entry-text :global(a:hover) {
		color: var(--entry-accent);
		background-size: 100% 2px;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.entry-inner {
			animation: none;
		}
	}
</style>
