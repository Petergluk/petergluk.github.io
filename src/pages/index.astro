---
import Layout from '../layouts/Layout.astro';
import homeData from '../data/pages/home.json';
---

<Layout
	title={homeData.title}
	description={homeData.description}
	entry={true}
>
	<main id="content" class="entry">
		<div class="entry-inner">
			<div class="entry-portrait">
				<img src={homeData.portrait} alt="Пётр Глухов" />
			</div>
			<div class="entry-content">
				<p class="entry-text" set:html={homeData.intro_text}></p>
			</div>
		</div>
	</main>
</Layout>

<style>
	.entry {
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 3rem 1.75rem;
		background-color: var(--entry-bg);
		background-image: radial-gradient(circle at 100% 0%, var(--entry-glow, transparent) 0%, transparent 60%);
	}

	.entry-inner {
		max-width: 60rem;
		animation: rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
		display: grid;
		grid-template-columns: 1fr;
		gap: 3rem;
		align-items: center;
	}

	@media (min-width: 768px) {
		.entry-inner {
			grid-template-columns: 280px 1fr;
			gap: 4rem;
		}
	}

	.entry-portrait {
		width: 100%;
		max-width: 320px;
		margin: 0 auto;
	}

	.entry-portrait img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: 0 20px 40px -10px rgba(0,0,0,0.15);
	}

	.entry-text {
		font-family: var(--display);
		font-weight: 400;
		font-size: clamp(1.7rem, 4vw, 2.75rem);
		line-height: 1.35;
		color: var(--entry-ink-dim);
		margin: 0;
	}

	.entry-text a {
		color: var(--entry-ink);
		text-decoration: none;
		font-weight: 600;
		background-image: linear-gradient(var(--entry-accent), var(--entry-accent));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 2px;
		transition: background-size 0.3s ease, color 0.2s ease;
	}

	.entry-text a:hover {
		color: var(--entry-accent);
		background-size: 100% 2px;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.entry-inner {
			animation: none;
		}
	}
</style>
