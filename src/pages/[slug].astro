---
import Layout from '../layouts/Layout.astro';
import { marked } from 'marked';
import ScrollReveal from '../components/ScrollReveal.tsx';

export async function getStaticPaths() {
	const pageFiles = import.meta.glob('../data/landings/*.json', { eager: true });
	
	return Object.keys(pageFiles).map(filePath => {
		const page = pageFiles[filePath] as any;
		const slug = filePath.split('/').pop()?.replace('.json', '');
		return {
			params: { slug },
			props: { page }
		}
	});
}

const { page } = Astro.props;
const blocks = page.blocks || [];
---

<Layout title={page.title} description={page.description}>
	<main id="content">
		{blocks.map((block: any, index: number) => {
			if (block.type === 'hero') {
				return (
					<ScrollReveal client:visible>
					<section class="page-hero">
						<div class="wrap">
							{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
							<h1>{block.title}</h1>
							{block.lede && <p class="lede">{block.lede}</p>}
						</div>
					</section>
					</ScrollReveal>
				);
			}
			
			if (block.type === 'text_block') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap" style="font-size: 1.1rem; line-height: 1.6;">
							<div class="prose" set:html={block.content ? marked.parse(block.content) : ''} />
						</div>
					</section>
					</ScrollReveal>
				);
			}
			
			if (block.type === 'grid') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap">
							{(block.eyebrow || block.title || block.description) && (
								<div class="section-head">
									{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
									{block.title && <h2>{block.title}</h2>}
									{block.description && <p class="muted">{block.description}</p>}
								</div>
							)}
							
							<div class={`grid grid-${block.columns || '3'}`}>
								{(block.items || []).map((item: any, i: number) => {
									const inner = (
										<>
											{item.image ? (
												<div class="card-cover" style={`background-image: url('${item.image}'); background-size: cover; background-position: center; min-height: 200px;`} />
											) : (
												<div class="card-cover" style={`background-image: url('/images/defolt/bg_${String((i % 15) + 1).padStart(2, "0")}.jpg'); background-size: cover; background-position: center; min-height: 160px;`} />
											)}
											<div style="padding: 1.5rem;">
												<h3 style="font-size: 1.6rem; margin-top: 0; margin-bottom: 0.5rem; line-height: 1.2;">{item.title}</h3>
												{item.text && <p class="muted" style="margin-bottom: 0;">{item.text}</p>}
											</div>
										</>
									);
									
									return item.url ? (
										<a class="card" href={item.url} style="text-decoration: none; color: inherit; display: flex; flex-direction: column; overflow: hidden;">
											{inner}
										</a>
									) : (
										<div class="card" style="display: flex; flex-direction: column; overflow: hidden;">
											{inner}
										</div>
									);
								})}
							</div>
						</div>
					</section>
					</ScrollReveal>
				);
			}
			
			if (block.type === 'cta') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap" style={block.center !== false ? 'text-align: center;' : ''}>
							{(block.eyebrow || block.title || block.description) && (
								<div class="section-head" style={block.center !== false ? 'margin-left: auto; margin-right: auto;' : ''}>
									{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
									{block.title && <h2>{block.title}</h2>}
									{block.description && <p class="muted">{block.description}</p>}
								</div>
							)}
							<div class="cta-row" style={block.center !== false ? 'justify-content: center;' : ''}>
								{(block.buttons || []).map((btn: any) => (
									<a class={`btn ${btn.secondary ? 'secondary' : ''}`} href={btn.url}>
										{btn.text}
									</a>
								))}
							</div>
						</div>
					</section>
					</ScrollReveal>
				);
			}
						
			if (block.type === 'image_text') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap">
							<div style={`display: grid; gap: 3rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); align-items: center;`}>
								<div style={block.image_right ? 'order: 1;' : 'order: 2;'}>
									{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
									{block.title && <h2 style="margin-top: 0;">{block.title}</h2>}
									<div class="prose" set:html={block.content ? marked.parse(block.content) : ''} />
								</div>
								{block.image && (
									<div style={block.image_right ? 'order: 2;' : 'order: 1;'}>
										<img src={block.image} alt={block.title || ''} style="width: 100%; border-radius: var(--radius); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);" />
									</div>
								)}
							</div>
						</div>
					</section>
					</ScrollReveal>
				);
			}

			if (block.type === 'accordion') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap">
							{(block.eyebrow || block.title) && (
								<div class="section-head">
									{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
									{block.title && <h2>{block.title}</h2>}
								</div>
							)}
							<div class="accordion-list" style="display: flex; flex-direction: column; gap: 1rem;">
								{(block.items || []).map((item: any) => (
									<details style="background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.5rem;">
										<summary style="font-size: 1.1rem; font-weight: 500; cursor: pointer; list-style-position: inside;">{item.title}</summary>
										<div class="prose" style="margin-top: 1rem; color: var(--prose-ink);" set:html={item.content ? marked.parse(item.content) : ''} />
									</details>
								))}
							</div>
						</div>
					</section>
					</ScrollReveal>
				);
			}

			if (block.type === 'video') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap" style="text-align: center;">
							{(block.eyebrow || block.title) && (
								<div class="section-head">
									{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
									{block.title && <h2>{block.title}</h2>}
								</div>
							)}
							<div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; border-radius: var(--radius); background: #000;">
								<iframe src={block.url} style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" allowfullscreen></iframe>
							</div>
						</div>
					</section>
					</ScrollReveal>
				);
			}

			if (block.type === 'reviews') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap">
							{(block.eyebrow || block.title) && (
								<div class="section-head">
									{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
									{block.title && <h2>{block.title}</h2>}
								</div>
							)}
							<div style="display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
								{(block.items || []).map((item: any) => (
									<div class="card" style="padding: 2rem; display: flex; flex-direction: column;">
										<p style="font-size: 1.1rem; line-height: 1.6; font-style: italic; margin-bottom: 1.5rem; flex-grow: 1;">"{item.text}"</p>
										<div>
											<strong>{item.author}</strong>
											{item.subtitle && <div class="muted" style="font-size: 0.9rem; margin-top: 0.25rem;">{item.subtitle}</div>}
										</div>
									</div>
								))}
							</div>
						</div>
					</section>
					</ScrollReveal>
				);
			}

			if (block.type === 'html') {
				return (
					<ScrollReveal client:visible>
					<section class={`band ${block.warm_bg ? 'band-warm' : ''}`}>
						<div class="wrap" style="text-align: center;">
							{(block.eyebrow || block.title) && (
								<div class="section-head">
									{block.eyebrow && <span class="eyebrow">{block.eyebrow}</span>}
									{block.title && <h2>{block.title}</h2>}
								</div>
							)}
							<div set:html={block.code || ''} />
						</div>
					</section>
					</ScrollReveal>
				);
			}

			return null;
		})}
	</main>
</Layout>
