---
import Layout from '../layouts/Layout.astro';

const meditative = [
	{
		title: 'Дыхательные практики',
		text: 'Дыхание — пространство между умом и телом, в котором разворачиваются переживания. Работаем с дыхательным рисунком, чтобы освободить то, что оно сдерживает.',
	},
	{
		title: 'Випассана в движении',
		text: 'Медитация с закрытыми глазами, в движении. Нет способа проверить «правильно ли я делаю» — и самого «правильно» тоже нет. Движение движется через нас.',
	},
	{
		title: 'Остановка внутреннего диалога (ОВД)',
		text: 'Не борьба с собой, а особая настройка восприятия, в которой тело и мир становятся текучими. Когда видишь, как «делается» внутренний диалог — появляется выбор не делать.',
	},
	{
		title: 'Практики восприятия и времени',
		text: 'Переключение внимания с привычной оптики на то, что обычно остаётся за кадром: ощущение времени, будущего, скрытых импульсов движения.',
	},
	{
		title: 'Релаксационные практики',
		text: 'Мягкая настройка на состояние покоя без задачи «стать лучше» — просто дать телу и вниманию замедлиться и собраться.',
	},
	{
		title: 'Практики для работы с эмоциями и дискомфортом',
		text: 'Учимся быть с сложным ощущением или переживанием без борьбы с ним — и находить в нём ресурс, а не только проблему.',
	},
];

const bodywork = [
	{
		title: 'Внимательное Прикосновение',
		text: 'Класс о том, что происходит в телесной работе на уровне внимания. Когда руки только следуют за вниманием, лёгкое прикосновение даёт телу более глубокую перезагрузку, чем часы жёсткой мануальной рутины.',
	},
	{
		title: 'Ритм в телесной работе',
		text: 'Массаж как перформанс. Живой, пульсирующий ритм останавливает внутренний диалог и погружает в кинестетический транс — исследуем, как работать с этим сознательно.',
	},
	{
		title: 'Тряхнём чакрами',
		text: 'Практика осознавания контура психосоматического напряжения через движение. Как структура телесных зажимов буквально определяет «какой я».',
	},
	{
		title: 'Массажный Джем',
		text: 'Групповая тактильная практика: внимательность, контакт, ритм и сонастроенность. Формат камерный, модерируемый, с чётким принципом согласия.',
	},
];

const formats = [
	{ title: 'Мастер-класс', text: '1,5–2 часа, фестивальный или студийный формат' },
	{ title: 'Однодневный интенсив', text: 'Погружение в одну тему с практикой' },
	{ title: 'Семинар 2–3 дня', text: 'Глубокая проработка навыка' },
	{ title: 'Курс или ретрит', text: 'До 10 дней — полное погружение' },
];
---

<Layout
	title="Мастер-классы и семинары — Пётр Глухов"
	description="Классы по медитативным и дыхательным практикам, соматическим зарядкам, телесной работе и психосоматике. От фестивального мастер-класса до многодневного семинара."
>
	<main id="content">
		<section class="page-hero">
			<div class="wrap">
				<span class="eyebrow">Группы и семинары</span>
				<h1>Мастер-классы и семинары</h1>
				<p class="lede">
					Медитативные практики, соматические зарядки, работа с телом и психосоматика — от
					полуторачасового класса до курса на несколько дней.
				</p>
			</div>
		</section>

		<!-- Организаторам -->
		<section class="band band-warm">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">Организаторам</span>
					<h2>Приглашайте в свой город</h2>
					<p class="muted">
						Сейчас я путешествую и открыт к выступлениям на новых площадках: студии,
						фестивали, ретрит-центры, камерные пространства. Большинство классов не
						требуют от участников подготовки и подходят как телесным практикам и
						массажистам, так и людям без опыта.
					</p>
				</div>
				<div class="grid grid-4">
					{
						formats.map((item) => (
							<div class="card format-card">
								<h3>{item.title}</h3>
								<p class="muted">{item.text}</p>
							</div>
						))
					}
				</div>
				<div class="cta-row">
					<a class="btn" href="https://t.me/Petergluk">Обсудить в Telegram</a>
					<a class="btn secondary" href="https://wa.me/qr/RX52QNWK3LNOB1">WhatsApp</a>
				</div>
			</div>
		</section>

		<!-- Медитативные практики -->
		<section class="band">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">Направление</span>
					<h2>Управляемые медитативные практики</h2>
					<p class="muted">
						Голосом, в формате управляемой медитации. Каждый класс — отдельный фокус.
					</p>
				</div>
				<div class="grid grid-3">
					{
						meditative.map((item) => (
							<div class="card">
								<h3>{item.title}</h3>
								<p class="muted">{item.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Работа с телом -->
		<section class="band band-warm">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">Направление</span>
					<h2>Работа с телом</h2>
					<p class="muted">
						Телесная работа и массаж — практикум с теорией и практикой в парах.
					</p>
				</div>
				<div class="grid grid-2">
					{
						bodywork.map((item) => (
							<div class="card">
								<h3>{item.title}</h3>
								<p class="muted">{item.text}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- Зарядки и психосоматика -->
		<section class="band">
			<div class="wrap">
				<div class="grid grid-2">
					<div class="card">
						<span class="tag">Соматические зарядки</span>
						<h3>Утренняя пробуждающая практика</h3>
						<p class="muted">
							Не «зарядка» в спортзальном смысле — созерцание ощущений тела в
							движении, бережная синхронизация с собой и дыханием. Каждый день
							практика немного другая. Подходит абсолютно всем, даже тем, кто не
							уверен, что хочет просыпаться.
						</p>
					</div>
					<div class="card">
						<span class="tag">Психосоматика</span>
						<h3>Смысл Симптома</h3>
						<p class="muted">
							Всё, что происходит в сознании, отражается в теле — и наоборот. Всякий
							телесный симптом имеет смысл; жизненные тупики и повторяющиеся истории
							имеют телесную локализацию. Формат — семинар-лаборатория: без нудных
							лекций, с живыми разборами на добровольцах из зала.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="band band-dark">
			<div class="wrap-narrow" style="text-align: center;">
				<span class="eyebrow">Сотрудничество</span>
				<h2>Хотите класс у себя?</h2>
				<p class="muted">Напишите — обсудим тему, формат и даты.</p>
				<div class="cta-row" style="justify-content: center;">
					<a class="btn" href="https://t.me/Petergluk">Telegram</a>
					<a class="btn secondary" href="https://wa.me/qr/RX52QNWK3LNOB1">WhatsApp</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

<style>
	.format-card {
		padding: 1.3rem 1.4rem;
	}

	.format-card h3 {
		font-size: 1.05rem;
	}

	.format-card p {
		margin: 0;
		font-size: 0.92rem;
	}
</style>
