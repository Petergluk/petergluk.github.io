---
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	entry?: boolean;
	frontmatter?: { title?: string; description?: string };
}

const { title, description, entry = false, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? "Пётр Глухов — соматический коуч, телесный практик";
const pageDescription =
	description ??
	frontmatter?.description ??
	"Соматический метакоучинг онлайн, телесные сессии и массаж очно, мастер-классы и семинары по телесной работе и психосоматике.";

const nav = [
	{ href: "/sessions/", label: "Сессии" },
	{ href: "/classes/", label: "Мастер-классы" },
	{ href: "/texts/", label: "Тексты" },
	{ href: "/contacts/", label: "Контакты" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<title>{pageTitle}</title>
		<script is:inline>
			// Ставим тему до первой отрисовки, чтобы не мигало
			(() => {
				const saved = localStorage.getItem('theme');
				const prefersDark =
					window.matchMedia &&
					window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme =
					saved === 'light' || saved === 'dark' ? saved : prefersDark ? 'dark' : 'light';
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&display=swap"
		/>
		<ClientRouter />
	</head>
	<body>
		<a class="skip" href="#content">К содержанию</a>

		<header class={entry ? "header-entry" : ""}>
			<nav>
				{
					!entry && (
						<a href="/" class="brand" aria-label="На главную">
							<span class="brand-mark">PG</span>
						</a>
					)
				}

				{
					!entry && (
						<div class="links">
							{nav.map((item) => (
								<a
									href={item.href}
									class={
										currentPath === item.href ||
										(item.href !== "/" && currentPath.startsWith(item.href))
											? "active"
											: ""
									}
								>
									{item.label}
								</a>
							))}
						</div>
					)
				}

				<div class="nav-actions">
					<button class="theme-toggle" id="theme-toggle" aria-label="Переключить тему">
						<svg
							class="icon-sun"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="4.2"></circle>
							<path
								d="M12 3.4v2.1M12 18.5v2.1M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M3.4 12h2.1M18.5 12h2.1M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5"
							></path>
						</svg>
						<svg
							class="icon-moon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M20 14.2A8.2 8.2 0 1 1 9.8 4a6.6 6.6 0 0 0 10.2 10.2Z"></path>
						</svg>
					</button>

					<button
						class="menu-toggle"
						id="menu-toggle"
						aria-label="Открыть меню"
						aria-expanded="false"
						aria-controls="site-menu"
					>
						<span class="menu-bars" aria-hidden="true"></span>
					</button>
				</div>
			</nav>
		</header>

		<div class="menu-overlay" id="site-menu" hidden>
			<button class="menu-close" id="menu-close" aria-label="Закрыть меню">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>
			<nav class="menu-panel" aria-label="Основное меню">
				<ul class="menu-list">
					{
						nav.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<slot />

		<footer class={entry ? "footer-hidden" : ""}>
			<div class="footer-inner">
				<div class="footer-col footer-brand">
					<p class="footer-name">Пётр Глухов</p>
					<p class="footer-tagline">
						Соматический коуч и телесный практик. Работаю с сознанием через тело — и с
						телом через сознание.
					</p>
				</div>
				<div class="footer-col">
					<p class="footer-label">Связаться</p>
					<a href="https://t.me/Petergluk">Telegram</a>
					<a href="/contacts/">Контакты</a>
				</div>
				<div class="footer-col">
					<p class="footer-label">Смотреть</p>
					<a href="https://t.me/danceofsense">Телеграм-канал</a>
					<a href="https://www.youtube.com/channel/UCAkcsu8N_58xybHc_KgyrBA">YouTube</a>
					<a href="https://photos.app.goo.gl/kVSBV58ioTUoUSCNA">Отзывы</a>
				</div>
			</div>
			<div class="footer-base">
				<span>© {new Date().getFullYear()} Пётр Глухов</span>
			</div>
		</footer>

		<script>
			import Lenis from 'lenis';

			let lenisInstance: Lenis | null = null;
			let isKeydownAttached = false;

			function init() {
				// --- Плавная инерционная прокрутка ---
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				if (!reduceMotion && !lenisInstance) {
					lenisInstance = new Lenis({
						duration: 1.1,
						smoothWheel: true,
					});

					function raf(time: number) {
						lenisInstance?.raf(time);
						requestAnimationFrame(raf);
					}
					requestAnimationFrame(raf);
				}

				// Обработка якорей через делегирование (можно вешать каждый раз, так как document не меняется,
				// но лучше повесить один раз)
				if (!window.hasOwnProperty('lenisAnchorsAttached') && !reduceMotion) {
					Object.defineProperty(window, 'lenisAnchorsAttached', { value: true });
					document.addEventListener('click', (e) => {
						const link = (e.target as HTMLElement).closest('a[href^="#"]');
						if (!link) return;
						const id = link.getAttribute('href')?.slice(1);
						const target = id ? document.getElementById(id) : null;
						if (target && lenisInstance) {
							e.preventDefault();
							lenisInstance.scrollTo(target, { offset: -80 });
						}
					});
				}

				// --- Плавное появление блоков при скролле ---
				const revealTargets = document.querySelectorAll(
					'.card, .prose > *, .toc'
				);

				if (revealTargets.length && !reduceMotion) {
					revealTargets.forEach((el) => el.classList.add('reveal'));

					const revealObserver = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									entry.target.classList.add('is-revealed');
									revealObserver.unobserve(entry.target);
								}
							});
						},
						{ rootMargin: '0px 0px -5% 0px', threshold: 0.05 }
					);

					revealTargets.forEach((el) => revealObserver.observe(el));
				}

				// --- Переключение темы с расходящимся кругом ---
				const themeToggle = document.getElementById('theme-toggle');

				if (themeToggle) {
					const root = document.documentElement;

					const apply = (next: string) => {
						root.dataset.theme = next;
						localStorage.setItem('theme', next);
					};

					themeToggle.addEventListener('click', (event) => {
						const next = root.dataset.theme === 'dark' ? 'light' : 'dark';

						const reduceMotion = window.matchMedia(
							'(prefers-reduced-motion: reduce)'
						).matches;

						// @ts-expect-error — startViewTransition есть не во всех браузерах
						if (reduceMotion || !document.startViewTransition) {
							apply(next);
							return;
						}

						// Круг расходится из центра кнопки
						const rect = (event.currentTarget as HTMLElement).getBoundingClientRect();
						const x = ((rect.left + rect.width / 2) / window.innerWidth) * 100;
						const y = ((rect.top + rect.height / 2) / window.innerHeight) * 100;
						root.style.setProperty('--reveal-x', `${x}%`);
						root.style.setProperty('--reveal-y', `${y}%`);

						root.classList.add('theme-transitioning');
						// В светлую тему круг сходится обратно
						root.classList.toggle('reveal-back', next === 'light');

						// @ts-expect-error — см. выше
						const transition = document.startViewTransition(() => apply(next));
						
						transition.finished.finally(() => {
							root.classList.remove('theme-transitioning', 'reveal-back');
						});
					});
				}

				// --- Меню ---
				const toggle = document.getElementById('menu-toggle');
				const menu = document.getElementById('site-menu');

				if (toggle && menu) {
					const setOpen = (open: boolean) => {
						toggle.setAttribute('aria-expanded', String(open));
						toggle.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
						toggle.classList.toggle('is-open', open);
						document.body.classList.toggle('menu-open', open);

						if (open) {
							menu.hidden = false;
							requestAnimationFrame(() => menu.classList.add('is-visible'));
						} else {
							menu.classList.remove('is-visible');
							setTimeout(() => {
								if (toggle.getAttribute('aria-expanded') === 'false') menu.hidden = true;
							}, 300);
						}
					};

					toggle.addEventListener('click', () => {
						setOpen(toggle.getAttribute('aria-expanded') !== 'true');
					});

					menu.addEventListener('click', (event) => {
						const target = event.target as HTMLElement;
						if (target === menu || target.tagName === 'A' || target.closest('#menu-close')) {
							setOpen(false);
						}
					});

					if (!isKeydownAttached) {
						document.addEventListener('keydown', (event) => {
							const currentToggle = document.getElementById('menu-toggle');
							if (event.key === 'Escape' && currentToggle?.getAttribute('aria-expanded') === 'true') {
								currentToggle.click();
							}
						});
						isKeydownAttached = true;
					}
				}
			}

			// Инициализация скриптов при первой загрузке и после переходов (Astro View Transitions)
			document.addEventListener('astro:page-load', init);

			// --- Восстановление темы после переходов между страницами ---
			document.addEventListener('astro:after-swap', () => {
				const saved = localStorage.getItem('theme');
				if (saved === 'light' || saved === 'dark') {
					document.documentElement.dataset.theme = saved;
				}
			});
		</script>
	</body>
</html>

<style is:global>
	/* ---------- Палитра входной страницы ---------- */
	:root {
		/* Размеры и шрифты — общие для обеих тем */
		--max: 1080px;
		--narrow: 720px;
		--radius: 14px;
		--display: 'Cormorant Garamond', Georgia, serif;
		--body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

		/* Тёмная палитра для входной страницы (по умолчанию или в тёмной теме) */
		--entry-bg: #0a0a0a;
		--entry-ink: #f5f4f2;
		--entry-ink-dim: rgba(245, 244, 242, 0.5);
		--entry-ink-soft: rgba(245, 244, 242, 0.65);
		--entry-accent: #e8946a;
		--entry-line: rgba(245, 244, 242, 0.18);
		--entry-card: rgba(245, 244, 242, 0.06);
	}

	/* Светлая палитра для входной страницы */
	:root[data-theme='light'] {
		--entry-bg: #faf6f0;
		--entry-ink: #241f1b;
		--entry-ink-dim: rgba(36, 31, 27, 0.65);
		--entry-ink-soft: rgba(36, 31, 27, 0.85);
		--entry-accent: #b4552d;
		--entry-line: rgba(36, 31, 27, 0.15);
		--entry-card: rgba(36, 31, 27, 0.05);
	}

	/* ---------- Дневная тема ---------- */
	:root,
	:root[data-theme='light'] {
		--ink: #241f1b;
		--ink-soft: #6b6259;
		--ink-faint: #796f62;
		--paper: #faf6f0;
		--paper-warm: #f3ece2;
		--card: #ffffff;
		--accent: #b4552d;
		--accent-deep: #8f4020;
		--accent-soft: #f6e6dc;
		--line: #e6ddd1;
		--on-accent: #ffffff;

		--header-bg: rgba(250, 246, 240, 0.85);
		--overlay-bg: rgba(250, 246, 240, 0.97);
		--hero-glow: #e9dfd2;
		--glow-warm: #f6e6dc;
		--glow-cool: #e9dfd2;
		--card-hover-line: #d9c9b6;
		--prose-ink: #3a332d;

		/* Контрастная полоса и подвал */
		--deep-bg: #2a2420;
		--deep-ink: #f2ece4;
		--deep-ink-soft: #b9afa4;
		--deep-heading: #ffffff;
		--deep-line: rgba(232, 224, 214, 0.12);
		--deep-faint: #857b71;

		--shadow: 0 1px 2px rgba(36, 31, 27, 0.04), 0 8px 24px -12px rgba(36, 31, 27, 0.14);
		--shadow-lift: 0 2px 4px rgba(36, 31, 27, 0.05), 0 18px 40px -16px rgba(36, 31, 27, 0.2);
		--btn-glow: rgba(143, 64, 32, 0.6);
	}

	/* ---------- Ночная тема: тёмно-синий + коричнево-оранжевый ---------- */
	:root[data-theme='dark'] {
		--ink: #e8e6e3;
		--ink-soft: #a9b0bb;
		--ink-faint: #828a96;
		--paper: #161d29;
		--paper-warm: #1c2532;
		--card: #212b39;
		--accent: #d97845;
		--accent-deep: #e98d58;
		--accent-soft: #33302f;
		--line: #2e3947;
		--on-accent: #1a1206;

		--header-bg: rgba(22, 29, 41, 0.85);
		--overlay-bg: rgba(22, 29, 41, 0.97);
		--hero-glow: #23303f;
		--glow-warm: #33261f;
		--glow-cool: #1e2a3a;
		--card-hover-line: #3d4b5c;
		--prose-ink: #d7d4d0;

		--deep-bg: #0f151e;
		--deep-ink: #d8d5d1;
		--deep-ink-soft: #8d949f;
		--deep-heading: #f2f0ed;
		--deep-line: rgba(216, 213, 209, 0.12);
		--deep-faint: #6b727d;

		--shadow: 0 1px 2px rgba(0, 0, 0, 0.2), 0 8px 24px -12px rgba(0, 0, 0, 0.5);
		--shadow-lift: 0 2px 4px rgba(0, 0, 0, 0.25), 0 18px 40px -16px rgba(0, 0, 0, 0.6);
		--btn-glow: rgba(217, 120, 69, 0.45);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		background: var(--paper);
		color: var(--ink);
		font-family: var(--body);
		font-size: 17px;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.skip {
		position: absolute;
		left: -9999px;
	}

	.skip:focus {
		left: 1rem;
		top: 1rem;
		z-index: 10;
		background: var(--card);
		padding: 0.6rem 1rem;
		border-radius: 8px;
	}

	main {
		flex: 1;
		width: 100%;
	}

	h1,
	h2,
	h3 {
		font-family: var(--display);
		line-height: 1.15;
		font-weight: 500;
		letter-spacing: -0.01em;
	}

	h1 {
		font-size: clamp(2.4rem, 6vw, 3.6rem);
		margin: 0 0 1.1rem;
	}

	h2 {
		font-size: clamp(1.7rem, 3.5vw, 2.3rem);
		margin: 0 0 0.9rem;
	}

	h3 {
		font-size: 1.25rem;
		font-weight: 600;
		margin: 0 0 0.5rem;
	}

	p {
		margin: 0 0 1rem;
	}

	a {
		color: var(--accent);
		text-underline-offset: 3px;
	}

	/* ---------- Шапка ---------- */
	header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: var(--header-bg);
		backdrop-filter: saturate(150%) blur(12px);
		border-bottom: 1px solid var(--line);
	}

	nav {
		max-width: var(--max);
		margin: 0 auto;
		padding: 0.85rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	nav .brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--ink);
	}

	.brand-mark {
		width: 42px;
		height: 42px;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: linear-gradient(120deg, #163659 40%, #ea5c15 60%);
		color: #ffffff;
		font-family: var(--display);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	nav .links {
		display: flex;
		gap: 1.4rem;
		flex-wrap: wrap;
	}

	nav .links a {
		position: relative;
		text-decoration: none;
		color: var(--ink-soft);
		font-size: 0.92rem;
		padding: 0.2rem 0;
		transition: color 0.2s;
	}

	nav .links a::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 1.5px;
		background: var(--accent);
		transform: scaleX(0);
		transition: transform 0.25s ease;
	}

	nav .links a:hover,
	nav .links a.active {
		color: var(--accent);
	}

	nav .links a.active::after,
	nav .links a:hover::after {
		transform: scaleX(1);
	}

	/* ---------- Шапка на входной странице: кнопки уходят в угол, почти незаметны ---------- */
	.header-entry {
		position: fixed;
		background: transparent;
		backdrop-filter: none;
		border-bottom: none;
	}

	.header-entry nav {
		justify-content: flex-end;
		padding: 1.1rem 1.3rem;
	}

	/* ---------- Переключатель темы ---------- */
	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.theme-toggle {
		width: 40px;
		height: 40px;
		flex: none;
		display: grid;
		place-items: center;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--card);
		color: var(--ink-soft);
		cursor: pointer;
		transition:
			color 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
	}

	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
		transform: scale(1.05);
	}

	/* На входной странице кнопки почти невидимы, пока на них не наводишь */
	.header-entry .theme-toggle,
	.header-entry .menu-toggle {
		border-color: transparent;
		background: transparent;
		opacity: 0.55;
	}

	.header-entry .theme-toggle:hover,
	.header-entry .menu-toggle:hover {
		opacity: 1;
		border-color: var(--entry-line);
		background: var(--entry-card);
	}

	.header-entry .theme-toggle {
		color: var(--entry-ink-soft);
	}

	.header-entry .menu-bars,
	.header-entry .menu-bars::before,
	.header-entry .menu-bars::after {
		background: var(--entry-ink-soft);
	}

	.theme-toggle svg {
		width: 19px;
		height: 19px;
		grid-area: 1 / 1;
		transition:
			opacity 0.25s ease,
			transform 0.35s ease;
	}

	.icon-moon {
		opacity: 0;
		transform: rotate(-40deg) scale(0.7);
	}

	:root[data-theme='dark'] .icon-sun {
		opacity: 0;
		transform: rotate(40deg) scale(0.7);
	}

	:root[data-theme='dark'] .icon-moon {
		opacity: 1;
		transform: rotate(0) scale(1);
	}

	/* ---------- Плавные переходы между страницами (fade) ---------- */
	::view-transition-old(root) {
		animation: page-fade-out 1s ease-out both;
		mix-blend-mode: normal;
	}
	::view-transition-new(root) {
		animation: page-fade-in 1s ease-in both;
		mix-blend-mode: normal;
	}

	@keyframes page-fade-in {
		from { opacity: 0; }
