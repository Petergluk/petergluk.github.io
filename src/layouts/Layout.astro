	/* ---------- Расходящийся круг при смене темы (отменяет fade) ---------- */
	html.theme-transitioning::view-transition-old(root) {
		animation: none;
		z-index: 1;
	}

	html.theme-transitioning::view-transition-new(root) {
		z-index: 2;
		animation: theme-reveal 0.55s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}

	html.theme-transitioning.reveal-back::view-transition-old(root) {
		z-index: 2;
		animation: theme-reveal 0.55s cubic-bezier(0.4, 0, 0.2, 1) reverse forwards;
	}

	html.theme-transitioning.reveal-back::view-transition-new(root) {
		z-index: 1;
		animation: none;
	}

	@keyframes theme-reveal {
		from {
			clip-path: circle(0% at var(--reveal-x, 50%) var(--reveal-y, 50%));
		}
		to {
			clip-path: circle(150% at var(--reveal-x, 50%) var(--reveal-y, 50%));
		}
